{
	"name": "angelic-pastries",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
		"dotenvx": "dotenvx",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"build": "cross-env NODE_OPTIONS=--no-deprecation NODE_OPTIONS=--no-deprecation SKIP_YARN_COREPACK_CHECK=0 dotenvx run -f .env.production -- next build --experimental-build-mode compile",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
		"stripe:login": "stripe login",
		"stripe:webhooks": "stripe listen --forward-to localhost:3000/api/payments/stripe/webhooks",
		"encrypt-env": "cp .env.production.local .env.production && dotenvx encrypt -f .env.production"
	},
	"dependencies": {
		"@dotenvx/dotenvx": "^2.4.1",
		"@hcaptcha/react-hcaptcha": "^2.0.2",
		"@payloadcms/db-mongodb": "^3.86.0",
		"@payloadcms/email-nodemailer": "^3.86.0",
		"@payloadcms/next": "^3.86.0",
		"@payloadcms/plugin-ecommerce": "^3.86.0",
		"@payloadcms/plugin-stripe": "^3.86.0",
		"@payloadcms/richtext-lexical": "^3.86.0",
		"@payloadcms/ui": "^3.86.0",
		"@radix-ui/react-slot": "^1.3.0",
		"@stripe/react-stripe-js": "^6.7.0",
		"@stripe/stripe-js": "^9.9.0",
		"@swc/core": "^1.15.43",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "^17.4.2",
		"graphql": "^17.0.2",
		"lucide-react": "^1.24.0",
		"next": "^16.2.10",
		"payload": "^3.86.0",
		"react": "^19.2.7",
		"react-aria-components": "^1.19.0",
		"react-dom": "^19.2.7",
		"sharp": "^0.35.3",
		"stripe": "^22.3.1",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-react-aria-components": "^2.2.0",
		"turbo": "^2.10.4"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.6",
		"@eslint/js": "^10.0.1",
		"@eslint/migrate-config": "^3.0.0",
		"@hcaptcha/types": "^1.2.0",
		"@next/eslint-plugin-next": "^16.2.10",
		"@payloadcms/eslint-config": "^3.28.0",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/node": "^26",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@typescript/typescript6": "^6.0.2",
		"eslint": "^10.7.0",
		"eslint-config-next": "^16.2.10",
		"eslint-plugin-react": "^7.37.5",
		"globals": "^17.7.0",
		"postcss": "^8",
		"prettier": "^3.9.5",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.63.0"
	},
	"packageManager": "npm@12.0.1",
	"allowScripts": {
		"@swc/core@1.15.43": true,
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"sharp@0.35.3": true
	}
}
